PORT=4000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
COOKIE_SESSION_KEY=replace-with-a-long-random-secret

CLIENT_BASE_URL=https://ideahubs.org
SERVER_BASE_URL=https://api.ideahubs.org
OAUTH_SUCCESS_REDIRECT=https://ideahubs.org/oauth/callback

# 安卓/iOS App 的第三方登录深链回跳 scheme（只填 scheme 本身，不带 ://）。
# 留空 = 关闭该特性，OAuth 只回跳 CLIENT_BASE_URL（纯 Web 部署保持原样）。
# 填了之后，`?next=<scheme>://oauth` 会被放行并直接 302 到该深链，把 token 带回 App——
# App 端是系统浏览器在跑授权页（Google 拒绝嵌入式 WebView），没有深链就回不去。
# ★ 必须与 app 仓的两处一致：src/utils/oauth.ts 的 APP_SCHEME、
#   android/app/src/main/AndroidManifest.xml 的 intent-filter data scheme。
APP_OAUTH_SCHEME=ideahub

EMAIL_PROVIDER=resend
EMAIL_FROM=no-reply@ideahubs.org
RESEND_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# QQ 登录（QQ 互联「移动应用」）。两个都填齐才算开，半配等于没配。
# ★ 它**不走**上面 APP_OAUTH_SCHEME 那条深链：移动应用后台没有回调地址栏，
#   网页版 OAuth2.0 走不通。App 用原生 SDK 拿一次性 code，POST /api/auth/oauth/qq/native
#   由服务端换 openid，见 src/services/qqOauth.service.js。
# ★ QQ_APP_ID 是公开的（已经编译进 APK 了，android/app/build.gradle 里那份是同一个）；
#   QQ_APP_KEY 是**密钥**，只能待在这里，绝不能进 app 仓的任何 VITE_* 或 .env.production。
QQ_APP_ID=
QQ_APP_KEY=

ENABLE_AI_WORKER=true
AI_WORKER_POLL_MS=4000
AI_JOB_MAX_ATTEMPTS=3

# ── AI provider（provider-agnostic，由 src/services/aiClient.js 统一读取）────────
# 所有 AI service 走 /v1/chat/completions（各家「OpenAI 兼容」端点的最大公约数；
# 它们大多没有 OpenAI 专有的 /v1/responses）。换厂商只需改这三个变量，不用动代码。
#
# AI_BASE_URL  兼容端点地址；留空 = 用 SDK 默认（OpenAI 官方 https://api.openai.com/v1）
# AI_API_KEY   该 provider 的 API Key
# AI_MODEL     模型名；留空则用各调用点内置的默认模型
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# 向后兼容：未设置 AI_* 时自动回退到下面的 OPENAI_*（AI_* 优先）。
# 老部署可原样保留 OPENAI_API_KEY / OPENAI_MODEL 继续跑。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
# OPENAI_BASE_URL=

# ── 国内厂商示例（取消注释其一，并把 key 填到 AI_API_KEY）─────────────────────
# ⚠️ 以下 URL 与模型名仅为示例，一切以各厂商【当时的官方文档】为准。
#
# DeepSeek
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-chat
#
# 阿里云百炼 / 通义千问
# AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_MODEL=qwen-plus
#
# 火山方舟 / 豆包（AI_MODEL 填「推理接入点 ID」，不是模型名）
# AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# AI_MODEL=<推理接入点ID>
#
# 智谱 GLM
# AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AI_MODEL=glm-4-plus

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

OTP_PEPPER=replace-with-a-long-random-secret
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ── 手机号短信登录（短信验证码）─────────────────────────────────────────
# SMS_PROVIDER：dev（默认，只在服务器日志打印验证码、不真发）| aliyun-pnvs | off
# 生产要真发短信必须切到 aliyun-pnvs 并配好下面的 key/签名/模板，否则 capabilities.phoneEnabled=false、
# 前端不显示「手机登录」入口（避免给出发不出码的死按钮）。
SMS_PROVIDER=dev
#
# 阿里云「号码认证服务 PNVS · 短信认证」——个人实名即可用，免申请签名/模板/运营商报备。
# 开通后在控制台拿 AccessKey 与【系统赠送】的签名名/模板号填入：
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=
# ALIYUN_PNVS_SIGN_NAME=          # 短信签名（SendSmsVerifyCode 必填）
# ALIYUN_PNVS_TEMPLATE_CODE=      # 短信模板 CODE（如 100001 / SMS_xxxx，必填）
# ALIYUN_PNVS_SCHEME_NAME=        # 可选：方案名（若填，发送与校验必须一致）
# ALIYUN_PNVS_TEMPLATE_PARAM=     # 可选：模板参数 JSON，默认 {"code":"##code##"}；模板另有变量时覆盖
# ALIYUN_PNVS_REGION=cn-hangzhou  # 可选
# ALIYUN_PNVS_VERSION=2017-05-25  # 可选
# ALIYUN_PNVS_ENDPOINT=https://dypnsapi.aliyuncs.com/  # 可选

# Optional: override Node DNS servers (comma separated).
# Only needed when mongodb+srv fails with querySrv ECONNREFUSED
DNS_SERVERS=

# ── 豆包语音合成（openspeech）· 工坊 NPC 的嗓子 ────────────────────────
# ★ 与 ARK_API_KEY 是**两套完全不同的凭据**：不同域名、不同鉴权、不同控制台。
#   方舟没有 TTS（实测 129 个模型里一个都没有），拿 ARK key 调这里一定 401。
#
# 从哪儿拿：console.volcengine.com/speech → 开通「豆包语音合成模型2.0」→ API Key。
# ★ 要开通的是 **2.0**（seed-tts-2.0）。1.0 是另一件商品、另行计费，
#   没开通会回 45000030 requested resource not granted。
#
# 不配不会报错：/api/tts 回 501，App 静默退回浏览器内置合成器
#（但安卓 WebView 的 getVoices() 常年返回空数组 → 真机上等于没声音，
#  所以要真机有声，这条**必须**配在服务端；配在 App 的 .env.local 只对 npm run dev 有效）。
TTS_API_KEY=

# ── 火山方舟（Seedream 出图 / Seedance 出视频 / 豆包对话 / Seed3D 建模）──────
# App 整条 AI 出片管线都走 /api/ark 转发，密钥只在这里。
#
# ★ 与 TTS_API_KEY 是**两套完全不同的凭据**：不同域名（ark.cn-beijing.volces.com）、
#   不同控制台（console.volcengine.com/ark）。互换一定 401。
#
# ★ 这条**必须配在服务端**。配在 App 的 .env.local 只对 `npm run dev` 有效
#   （那是 vite 的 dev 代理）；打成 APK 后 vite 中间件根本不存在，而 Capacitor 对
#   未命中路径回 **200 + index.html**，App 侧表现成
#   「第 1 段生成失败：Unexpected token '<', "<!doctype"...」，工坊 NPC 同时哑火。
#   密钥也不能进前端包——APK 解一下就拿到了。
#
# 不配不会 500：/api/ark 回 501，App 侧会明说"这台服务器没配方舟密钥"。
# 自检：curl https://<host>/api/ark/health → {"ok":true,"ark":true,...}
ARK_API_KEY=

# 免费档出片限制的总开关（2026-10-07）。缺省 = 开：没付过钱的用户只能用「极速」「草稿」出普通片，
# （「草稿」两家都有：Seedance 2.0 mini · 480p，与海外的 MiniMax H3-Lite · 480P —— 后者 2026-10-26 加，清单在 tokens.FREE_VIDEO_ALLOW）
# 其余出视频（标准 / 高清 / 电影级 / 真人档 / 带参考视频的出片）回 403 PLAN_REQUIRED。
# 写 off 关掉 = **服务端**退回改版前的口径（只有 Seedance 电影级挡免费版，MiniMax H3 三档也都放开）—— 出事时的应急开关，改完重启生效。
# ⚠ App 那一侧靠 /api/ark/health 的 freeVideoGate 知道闸关了（变成 false）、跟着放开置灰；不读这一位的 App 版本
#   关闸之后照旧按自己档位表的 freeOk 置灰（旧版 App ≤ 2.61 本来就只挡电影级，对它们是真的恢复原样）。
#   见 docs/api-contract.md「免费版」那条。
# 判据只在 src/config/tokens.js 的 videoPlanDenial 一处。
# FREE_VIDEO_GATE=off

# 出图模型接班的总开关（2026-10-10；方舟第十批下线，2026-11-24 14:00 停服）。缺省 = 开：
# 已经装机的老 App 还在发的出图 id，发给方舟那一刻换成接班型号（在册 / 计价 / 流水仍认发来的 id）——
#   老 4.0（250828）→ 4.0 新版本（20260415）部署即切；4.5（251128）→ 5.0 pro（组图那条路 → 4.0 新版本）、
#   5.0 lite（260128）→ 4.0 新版本，都在 2026-11-24 13:00（北京时间）切。表与判据只在 src/config/tokens.js 的
#   IMAGE_MODEL_SUCCESSORS / upstreamImageModel 一处。
# 写 off 关掉 = 老 id 原样发给方舟（回滚用，改完重启生效）。
# ⚠ 2026-11-24 14:00 之后还关着 = 老 id 发给已经下线的模型，那批出图整条被拒（钱照「没受理就退」退回，图出不来）。
# ARK_IMAGE_ALIAS=off

# ── 真人视频档供应商（MiniMax 海螺 / Runway）─────────────────────────────
# 真人视频档的两家供应商代理；未配则 App 内真人档不可用。MiniMax 还管海外的「草稿 / 高清 / 电影级」（H3，见本节末尾）
# （/api/minimax、/api/runway 全部 501，App 据此把真人档置灰，谁的 key 先到就先亮谁）。
# ★ 两家**都已接钱包扣费**（chargedArkCall / chargedCall 同一序列：门禁→原子扣→转发→
#   没受理退→管理员免单记账）。价目：MiniMax 真人档见 config/tokens.MINIMAX_FLAT_COST、H3 见 MINIMAX_SEC_COST（都与 App 报价
#   跨仓钉死），Runway 见 RUNWAY_TOKENS_PER_SECOND —— **查不到价一律 501，绝不降级成免费**。
#   ⚠ 2026-09-25 更正：此前这里写着「生产配了 RUNWAY_API_KEY 启动自检会直接拒绝启动」，
#     那道硬闸在接上计费的同一批里已按它自己写的约定撤掉（server #78）。现在配它不会挡启动。
#
# ★★ MiniMax 有**两个站，两套账号、两把 key、两个域名**，互不相通：
#       中国站   MINIMAX_API_KEY       → https://api.minimaxi.com/v1
#       国际站   MINIMAX_INTL_API_KEY  → https://api.minimax.io/v1
#     判据只有 config/minimax 一处：显式 MINIMAX_REGION（cn / intl）优先，否则谁有 key 走谁；
#     两把都配了又没写 MINIMAX_REGION 时**生产自检会拒绝启动**（不让默认值替你决定钱从哪边出）。
#     ⚠ 任务**绑区域**：在哪个站建的只能在同一个站查询与取件。切区域会让在途任务查不到
#       （钱已经扣了）——要切就等在途任务跑完。
# 自检：curl https://<host>/api/minimax/health → {"ok":true,"minimax":true,"region":"intl"}
MINIMAX_API_KEY=
MINIMAX_INTL_API_KEY=
# cn | intl。只配了一把 key 时可以不写；两把都配就必须写
MINIMAX_REGION=
# MiniMax 出片受理之后失败时退不退钱（真人档报 Fail、H3 报 failed / cancelled；2026-10-07 起缺省退，H3 2026-10-26 起同归它管，services/taskRefund）。
# ⚠ MiniMax 只对「视频包」写明失败不扣，按量付费的失败任务计不计费没有书面说法 —— 对账单发现失败也被收了钱、
#   或者对不出结论（对账的两个前提见本节末尾 H3 那一段），写 off 关掉（关掉期间失败的那些账留着 open，打开之后清扫器还能接着退：
#   用户自己问到过失败的，按记下的那句直接退，受理之后 8 天内都行；没人问过的 H3 要回去问，而 H3 只查得到 7 天内的任务 —— 只有 7 天）。
#   ⚠ 真人档与 H3 共用这一个开关：关掉之后两样受理之后的失败都不退。
#   关着时用户自己轮询看见的失败记在账上、不再算「在跑」（不占 H3 的并发闸）；清扫器不去问 MiniMax ——
#   没人再来问的 H3 任务（出成了的、失败了的都一样）在 30 分钟里一直算「在跑」，占着并发闸（每人 4 发、全站 25 发）。
# ⚠ 关掉之后 /api/ark/health 的 minimaxFailRefund 变成 false —— App 对真人档与 H3 说「会自动退回」之前要看这一位
#   （failRefund 只说方舟、恒为 true）；不读这一位的 App 版本会照旧对真人档许诺退款。
# MINIMAX_FAIL_REFUND=off
#
# MiniMax H3（V2 出片，2026-10-26；海外的「草稿 / 高清 / 电影级」，POST /api/minimax/v2/video）：**没有单独的开关**，
#   跟着上面的站走 —— 只在国际站开（MiniMax 走国际站时 /api/ark/health 的 minimaxV2 为 true），走中国站的服务器上 V2 两条路由都 501。
#   ⚠ 所以要 H3 就得配 MINIMAX_INTL_API_KEY；两把都配时写 MINIMAX_REGION=intl。写 cn（或只配中国站的 key）= 这台服务器没有 H3：
#     App 不摆 H3 三档；出片地区门禁切 on 之后海外连 MiniMax 也不给（海外只准国际站），海外一档视频都没有。
#   用的是同一把国际站 key（只能按量付费：官方写明视频资源包不覆盖 H3）；失败退款同一个 MINIMAX_FAIL_REFUND。
#   价目（token/秒，tokens.MINIMAX_SEC_COST，与 App 档位表逐条相等）与免费档那一行（H3-Lite · 480P）都是代码里的常量，不做环境变量。
#   免费版在 H3 上只能纯文字出片（tokens.MINIMAX_V2_FREE_TEXT_ONLY，2026-10-26 终审）也是代码常量：放开要过代码评审，不在服务器上拨。
#   全站同时最多 25 发（官方上限 30，留了余量）、一个人同时最多 4 发 —— 写死在 routes/minimax.routes.js 的
#   V2_MAX_INFLIGHT / V2_MAX_INFLIGHT_PER_USER，不做环境变量。
#   成片落在 video-product.cdn.minimax.io（主机只在 config/minimax 一处），有时效；/api/ark/transfer-video 与发布时的兜底转存都认它。
#   ⚠ 带 H3 三档的 App 发版之前先定 MINIMAX_FAIL_REFUND：MiniMax 对按量付费的失败任务收不收钱没有书面说法。
#     不花钱的对账只在两个前提都成立时算数：① 只看国际站的行（region: "intl"；中国站是另一个账号、另一份账单）；
#     ② 那几发在账单上是从按量付费的余额里扣的（资源包本来就写明失败不扣，在它上面看到「没收」说明不了按量付费）。
#     都成立、都没收 → 保持缺省；有一发收了 → 写 off 再发版；凑不齐前提 = 没有结论：先付费小验一发 H3 受理之后的失败，
#     来不及就写 off 发版、有了结论再打开（做法见 docs/api-contract.md「MiniMax H3（V2）出片」→「失败退款」）。
#   自检：curl https://<host>/api/ark/health → "minimaxV2":true（只说这台服务器开没开；某个地区给不给看 GET /api/video/zone 的 providers）。
RUNWAY_API_KEY=

# ── 出片按地区（2026-10-26）──────────────────────────────────────────────
# 主人要求：境内（只有 CN）Seedance 与 MiniMax 都能选；海外（含港澳台 / 判不出 / Tor）只给 MiniMax **国际站**；
# 受全面制裁的四国（IR / CU / KP / SY）一家都不给。地区判定在 src/utils/geo.js，每个地区准用哪几个上游、
# 门禁、被拦时那句话在 src/config/videoRegion.js（两份名单都是代码里的常量，不做环境变量）。
# App 先看 /api/ark/health 的 videoZone 能力位，再问 GET /api/video/zone 拿 { zone, country, providers, gate }。
# ⚠ 下面这些「不给」**只在门禁 on 时才生效**：off / observe 时服务端一发都不拦，/api/video/zone 的 providers
#   也照常报这台服务器配了的全部几家（App 只照 providers 摆档 —— 所以切 off 是真的急停，不靠哪一版 App 自觉：
#   服务端切下去那一刻就不拦了；App 在下一次探 /api/video/zone 时（回前台 / 定时重探 / 收到 403 之后）才把 Seedance 摆回来）。
# 契约（端点形状、403 回包）与等主人拍板的几件（拦的范围、港澳台、肖像邀约、管理员例外、何时切 on）
# 见 docs/api-contract.md「出片地区」。
#
# 地区门禁开到哪一档（只管出视频：Seedance 按地区；MiniMax 出片（真人档与 H3）按地区 + 站 —— 海外只准国际站、受制裁的四国不给；
# 出图 / 对话 / TTS / Seed3D / 肖像邀约 / Runway 都不拦，范围等主人定）：
#   off     完全不管；
#   observe 判，但只记一行 would-deny 日志、照常放行（缺省）；
#   on      上面那几种出视频在扣钱之前回 403 REGION_UNAVAILABLE。
#   （执行只在 src/services/arkGateway.service.js 的 regionGate：管理员不豁免；轮询 / 取件 / 查询 / 转存一律不拦，
#    在途任务照常取得回来 —— 但样片第二步（升 1080p）、片段重拍、往后延长是新的 Seedance 出视频，照拦；
#    白模化在看帧之前就预检，被拦时连看帧那一发都不发；H3 出片在两道并发闸之前就预检，池子满的时候先说地区。）
# ⚠ 写了认不出的值按 observe 跑，**生产自检会拒绝启动**（以为开了、其实只在记日志）。什么时候切 on 等主人定。
# ⚠ 在服务器上手动拨这个开关（切 on / 急停切 off / 切回 observe），三步一步都别省：
#   1. 改 /var/www/ideahub-server/.env 里这一行；
#   2. cd /var/www/ideahub-server && NODE_ENV=production npm run check:config —— **通过了才往下走**；
#   3. 以 **deploy 用户** pm2 reload ecosystem.config.js --update-env。
#   每个 worker 启动时都跑同一份自检，认不出的值直接 exit(1)：手动拨开关不经过 deploy.sh 的 check:config，
#   写错一个字母（of / onn）重启之后**每个 worker 都起不来、整个 API 停掉**，不只是这道门禁 —— reload 也挡不住，挡在第 2 步。
#   用 reload 不用 restart（restart 先停掉全部 worker，约 3 秒 502）；不许用 root（pm2 reload 在 root 下会新建第二份服务，见 AGENTS.md）。
# ⚠ 切 on 之前先做完（全文见 docs/api-contract.md「出片地区」→「切 on 之前」）：
#   ① 旁加载包用 App 发版脚本的 --min-version-code 把强制更新门槛抬到认得 REGION_UNAVAILABLE、会读 /api/video/zone
#     的那一版（Play 版等那一版铺开）。老 App 照旧摆 Seedance 档，到视频那一发才吃 403，而推演、出片前补画设定帧
#     都不归门禁管、各自先扣钱：App 2.62 起补画好的帧随失败留在这一段上、重试不重画也不再收图钱（推演是另一步、重试不会再推演），
#     白付的是每段一轮；2.61 及更早每重试一次都重画、再收一遍图钱；
#   ② curl /api/minimax/health 确认 region 是 intl：MiniMax 走中国站（只配 MINIMAX_API_KEY，或 MINIMAX_REGION=cn）时，
#     海外连 MiniMax 也不给（海外只准国际站），切 on 那一刻海外就一家都没有了；
#   ③ 在中国以外、不是数据中心的网络上 curl -s -H 'cf-ipcountry: CN' https://<host>/api/video/zone，回的 country 必须是真实国家、
#     不是 CN（是 CN = Cloudflare 原样传了客户端自带的头，加一个头就能在海外拿到 Seedance，不许切 on）；不带这个头再跑一次，
#     country 不能是空的。★ observe 期间的 would-deny 日志核不了这一条：它只记该拦的，伪造成 CN 的那一发一行都不留；
#     再做完源站那一道加固（细节在运维的私有笔记，docs/api-contract.md「切 on 之前」第 3 步点了名）；
#   ④ 主人定已经付过钱的那几样豁不豁免：切下去那一刻海外用户付过第一步的样片升不了成片、付过钱的成片重拍不了 / 延长不了；
#   ⑤ 海外的免费用户（2026-10-26 已定）：留给他们的是 MiniMax H3-Lite · 480P（免费档里「草稿」的对标）—— 前提是 V2（H3）出片
#     在这台服务器上开着（只在国际站，config/minimax.minimaxV2Enabled）、带 H3 三档的那一版 App 已经铺开。缺一样，切下去那一刻
#     海外的免费用户一档视频都没有（Seedance 被地区拦，真人档在 FREE_VIDEO_GATE 开着时只给付费用户，地区门禁排在套餐门禁之前）。
# VIDEO_REGION_GATE=observe
#
# 开发用：把每个请求的出片地区钉死（cn | intl | blocked），在美国的开发机上测境内、在国内测海外。
# ⚠ **只配在本机**。生产配了它（不管写什么）**自检拒绝启动**，运行时也不认 —— 写 cn 就等于对海外放开 Seedance。
# VIDEO_ZONE_FORCE=cn

# ── 支付 ────────────────────────────────────────────────────────────────
# 充值链路的形状是「下单 → 渠道回调 → 结算发币」。发币**只**发生在回调结算里
# （src/services/payment/order.service.js 的 applyCallback），那里有幂等与金额校验。
#
# ⚠ 现在**一个真实渠道都没接**：src/services/payment/channels.js 的注册表是空的。
#   所以下单能下、订单会一直停在 created 直到超时关闭。这是故意的——
#   宁可"充不了值"，也不要留一个"谁调谁得 token"的口子。
#   接渠道 = 写一个 adapter（验签是它唯一也是全部的职责）+ 在那个注册表里注册，
#   路由和结算逻辑都不用动。商户密钥只写在这里，永远不进仓库、不进日志。
#
# PAY_ALLOW_MOCK=1 打开演示用假渠道。它**没有验签**（没有密钥可验），
# 任何人拿到一个 orderNo 就能把订单标成已支付。所以：
#   · 默认关闭；开着时每次启动都会打警告；
#   · NODE_ENV=production 下开着会**直接拒绝启动**（config/preflight.js）。
# 只在开发/演示环境用它走通流程。
PAY_ALLOW_MOCK=
# 订单多久没付自动关闭（分钟，默认 30，最小 5）
PAY_ORDER_TTL_MIN=

# ── 安卓 App 的版本清单（GET /api/app/latest.json）───────────────
# 服务端只是把 GitHub Release 上那份清单转一手（缓存 60 秒）。
# 为什么要转：App 每次冷启动都要拉它比版本号，国内直连 GitHub 常超时，
# 而超时的后果是**静默的**——用户永远收不到更新提示，也没有任何症状可看。
# 顺带留了个开关：清单在服务端，以后想把 APK 挪到 OSS/CDN 就不用重新出包。
# 两个都可以不配，不配就是下面这套默认行为。
# APP_MANIFEST_UPSTREAM=https://github.com/TianbinLiu/ideahub-app/releases/latest/download/latest.json
# APK 下载地址的替换前缀。留空 = 原样用清单里的 GitHub 地址。
# 设成例如 https://cdn.example.com/app/ 就能把下载挪到 CDN，**已装的 App 立刻生效**。
# APP_APK_BASE=

# ── 首页看板娘数字人（/api/companion）─────────────────────────────
# 对话走上面的 AI_* 配置（DeepSeek），语音走 TTS_API_KEY（豆包），这里只有两个可选项：
# 看板娘的名字（进提示词和界面），留空 = 小梦
COMPANION_NAME=
# 看板娘用的豆包音色 id，留空 = tts.routes.js 的默认音色（只收 2.0 音色，见 app 仓 studio/voices.ts 的选型硬约束）
COMPANION_TTS_VOICE=
# 对话记忆的上下文预算（token，产品预算不是模型上限：每轮都按输入计费）。用到 60% 界面提示、75% 回复后自动提纯。
# 留空 = 陪聊 32000 / 客服 16000（见 services/chatMemory.service.js）
COMPANION_CTX_BUDGET=
SUPPORT_CTX_BUDGET=
# 官网陪聊的首次告知同意（加州 SB 243 §22602(a)）。=1 时没点过「我已了解」的账号调 /api/companion/chat 拿 428。
# 默认关着：前端的同意框上线之后再打开，否则老前端会被挡在外面。只影响陪聊，不影响 App 客服。
COMPANION_REQUIRE_CONSENT=

# NCII 移除请求（TAKE IT DOWN Act §3）的通知收件人，逗号分隔。
# ★ 48 小时是**法定时限**，邮件是这条链路上唯一必须送达的通道 —— 留空则退回
#   SUPPORT_NOTIFY_EMAIL，再空则发给所有管理员账号的真实邮箱；全都没有时只会在日志里
#   留一行 error，请求会安安静静地躺在库里。**上线前务必填一个真人会看的地址。**
TAKEDOWN_NOTIFY_EMAIL=

# ── Google Play 结算（/api/pay/play）──────────────────────────────
# ★ 前三项缺一不可，缺了就整条关掉（/api/pay/config 的 play.enabled=false，redeem 回 501）。
#   这是刻意的：半配状态下「付了钱但发不了币」比「功能没上线」更糟。
# PLAY_SA_PRIVATE_KEY **一行、
 转义**，形如 "-----BEGIN PRIVATE KEY-----
MII…"。
#   ⚠ 它就是钱：泄露 = 别人能替我们查单甚至退款。只进 .env，永不入仓、不入日志。
# PLAY_RTDN_SECRET 是 Pub/Sub 推送 URL 上的 ?key=，自己生成一串随机值；
#   没配时 RTDN 端点一律 404（不暴露端点存在），退款仍靠每小时轮询兜底。
# PLAY_ACCOUNT_SALT 混淆账号 id 的盐；不配退回 JWT_SECRET。**换了它老购买就对不上账号**。
PLAY_PACKAGE_NAME=
PLAY_SA_EMAIL=
PLAY_SA_PRIVATE_KEY=
PLAY_RTDN_SECRET=
PLAY_ACCOUNT_SALT=

# ── App「AI 客服」（/api/support）───────────────────────────────────
# 客服的名字（默认跟 COMPANION_NAME 一样，都空则「小梦」）
SUPPORT_AGENT_NAME=
# 新工单/用户追加消息时发邮件通知谁（逗号分隔）。留空 = 发给库里所有 role=admin 且有真实邮箱的账号
SUPPORT_NOTIFY_EMAIL=
# 语音输入（/api/asr）与 TTS 共用 TTS_API_KEY，但「大模型录音文件识别·极速版」是控制台里另一个商品，要单独开通；
# 没开通时服务端日志会写明，客户端只看到"语音识别暂时不可用"

# ── 同款奖励（模板体系 P3b，docs/api-contract.md「同款奖励」）─────────────────────
# 别人按你的流程做了同款、公开发布满 24 小时 → 平台印 30k token 给原作者。缺省开；设成 false 关掉（不用发版）。
# 关着的时候清扫器照跑，只是把到期的同款一律记成不发（不攒着，重新打开也不补）。四个数在 src/config/remixReward.js。
REMIX_REWARD_ENABLED=
# 全站保险丝：任意连续 24 小时内全站最多发几次（正整数；不设 / 写坏了按缺省 100 次 ≈ 45 元 / 天）。
# 断了会给管理员发一封信（收件人同 NCII：TAKEDOWN_NOTIFY_EMAIL / SUPPORT_NOTIFY_EMAIL / 管理员账号的邮箱）。
# 是真的有这么多人在做同款就把它调大；像是被刷了就封号，或者把上面那个开关关掉。
REMIX_REWARD_GLOBAL_PER_DAY=

# ── 老师人格（tutor，tutor 仓 docs/05 §7.3 D1）────────────────────────────────
# TUTOR_ENABLED=true 才挂 /api/tutor 与它的 worker（为假时不 require，关开关不回滚代码）。
# 开了就要有 AI_API_KEY（上面那组）与 Cloudinary 三项；否则 preflight 拦下。
TUTOR_ENABLED=false
# 讲解 / 试教 / 判卷用的模型；蒸馏 / 阶段提议 / ① ⑥ / 扫描用便宜的那个。都留空 = 全站 AI_MODEL。
TUTOR_AI_MODEL_TEACH=
TUTOR_AI_MODEL_CHEAP=
# 单份教材上限（字节，缺省 100MB）与 /api/tutor 的 JSON 上限（缺省 8mb：教材 pages / 导入 .md）
TUTOR_MATERIAL_MAX_BYTES=
TUTOR_TEXT_JSON_LIMIT=
# 只给没模型的机器与 CI：生成 / 老师 / 判卷 / 蒸馏全走确定性演示规则、不扣钱。生产**不许**开。
TUTOR_ALLOW_DEMO=
# worker 抢生成作业的间隔（毫秒，缺省 3000）
TUTOR_WORKER_POLL_MS=
